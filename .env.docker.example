# Settings for docker-compose.yml. Copy to .env (git-ignored) and fill in every value.
# Never commit the real file: it holds the database password and the app's secrets.

# --- Addresses people use (no trailing slash) ---------------------------------
APP_PUBLIC_URL=http://bugtracker.example.com
BUGZILLA_PUBLIC_URL=http://bugtracker.example.com:8080
WEB_PORT=80
BUGZILLA_PORT=8080

# --- Database ----------------------------------------------------------------
# Password of the `bugs` database account, and of MariaDB's root (used only by MariaDB itself).
BZ_DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Bugzilla ----------------------------------------------------------------
# The Windows server's site_wide_secret (C:\Bugzilla\localconfig), so links and tokens issued
# before the move keep working. Leave empty for a brand-new install.
BZ_SITE_WIDE_SECRET=
# Only used when the database is EMPTY (no restored dump): the first administrator.
BZ_ADMIN_EMAIL=
BZ_ADMIN_PASSWORD=

# --- Backend (BFF) - same meaning as in backend/.env.example ------------------
# API key of a Bugzilla administrator (Bugzilla > Preferences > API Keys).
BUGZILLA_API_KEY=
# 32+ random characters each, e.g.  openssl rand -hex 32
SESSION_SECRET=
PROOF_LINK_SECRET=
PRODUCT_TRANSFER_ROUTES=KPost UI<->KPost API; KPost Admin UI<->KPost Admin
TRANSFER_API_KEY=
# true only once the site is served over HTTPS end to end.
HSTS=false
