# --- Dependencies & build output ---------------------------------------------
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# --- Secrets & local configuration -------------------------------------------
# Only *.example files are committed. Real values live on the server.
.env
.env.*
!.env.example
!.env.*.example

# --- Runtime data ------------------------------------------------------------
# Supervisor / app logs written by ops/app/bug-tracker-supervisor.ps1
logs/
*.log
# Server-side session files (SESSION_STORE=file)
backend/.sessions/

# --- Editors & OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Microsoft Office lock files (created while a document is open)
~$*
