# Build context for backend/Dockerfile. Only package*.json, tsconfig.json and src/ are needed.

# Secrets: injected as environment variables at runtime, never baked into an image.
.env
.env.*
!.env.example

# Runtime data and build output (rebuilt inside the image)
.sessions
node_modules
dist
coverage
*.log

# Tooling
Dockerfile
.dockerignore
*.md
