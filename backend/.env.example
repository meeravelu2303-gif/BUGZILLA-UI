# Copy to backend/.env and fill in. Never commit .env.

# Bugzilla's REST base. Must end in /rest. Calls are sent to the sibling
# /jsonrpc.cgi endpoint with credentials in request bodies (see lib/bugzillaClient.ts).
BUGZILLA_URL=http://localhost/rest

# Service API key (Bugzilla > Preferences > API Keys, created by an administrator).
# Used only for what a signed-in user's own token cannot do: proof links, the
# assignee directory, start-up and health checks.
BUGZILLA_API_KEY=

PORT=4000

# Signs session cookies. 32+ random characters, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Signs proof links in exported sheets. Separate from SESSION_SECRET so rotating
# one does not void the other. Optional; falls back to SESSION_SECRET.
PROOF_LINK_SECRET=

# true | false | auto   (auto = Secure when the request arrived over HTTPS)
COOKIE_SECURE=auto
# Set to true only once the site is served over HTTPS end to end.
HSTS=false

# false when clients connect directly; 1 behind one reverse proxy; 2 behind two.
TRUST_PROXY=false

# Where sessions live: memory (dev only) | file (default, survives restarts) | redis (multi-instance)
SESSION_STORE=file
# SESSION_DIR=D:\bugtracker\sessions
# REDIS_URL=redis://127.0.0.1:6379/0

# Comma-separated list of origins the web app is served from.
CORS_ORIGIN=http://localhost:5175

# Address other machines use for this app; links in exported sheets use it (not localhost).
PUBLIC_APP_URL=http://localhost:5175
PROOF_LINK_DAYS=30
STATS_CACHE_TTL_MS=60000

# Cross-product transfer (lib/productTransfer.ts): which product may hand bugs to which,
# and the dedicated non-admin account that performs the move (ops/bugzilla/setup-transfer-account.pl).
PRODUCT_TRANSFER_ROUTES=KPost UI<->KPost API; KPost Admin UI<->KPost Admin
# TRANSFER_API_KEY=
