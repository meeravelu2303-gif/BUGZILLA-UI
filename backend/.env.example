# Base URL of the Bugzilla REST API (include the /rest suffix)
BUGZILLA_URL=http://localhost/bugzilla/rest

# Service-level API key. Used ONLY for pre-login / non-user-scoped calls
# (startup connectivity check, /api/meta reachability probe). All per-user
# data operations use the logged-in user's own Bugzilla session token instead,
# so that Bugzilla's native group/permission model is respected per user.
# Generate one from the Bugzilla web UI: Preferences > API Keys.
BUGZILLA_API_KEY=

# Port the BFF listens on
PORT=4000

# Secret used to sign the session cookie (min 32 chars recommended).
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" behind HTTPS in production so the session cookie gets Secure flag
COOKIE_SECURE=false

# Comma-separated list of origins allowed to call this BFF (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173
