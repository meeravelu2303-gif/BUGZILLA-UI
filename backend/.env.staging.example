# STAGING backend - used only by `npm run dev:staging`. Never loaded together with .env.
# Points at the staging Bugzilla (D:/Bugzilla-staging, database bugs_staging, Apache 127.0.0.1:8081).
APP_ENV=staging
BUGZILLA_URL=http://127.0.0.1:8081/rest
# The staging database is a copy of live, so this key exists there too - for the same account,
# acting on staging data only. Rotate it on staging if that ever matters.
BUGZILLA_API_KEY=<API key of an admin account on staging>
PORT=4001
SESSION_SECRET=<random, 32+ chars>
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5176,http://127.0.0.1:5176
PUBLIC_APP_URL=http://localhost:5176
PROOF_LINK_DAYS=30
